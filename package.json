{
  "name": "opencode-spellcheck-v2",
  "version": "1.0.0",
  "description": "Проверка орфографии в реальном времени для OpenCode 2 TUI. Русский и английский языки.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nohau1/opencode-spellcheck-v2.git"
  },
  "homepage": "https://github.com/nohau1/opencode-spellcheck-v2#readme",
  "bugs": {
    "url": "https://github.com/nohau1/opencode-spellcheck-v2/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "tui",
    "spellcheck",
    "spelling",
    "russian",
    "english"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "tui.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "embed": "node scripts/embed-dictionary.mjs",
    "build": "npm run embed && npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.0",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@opencode/plugin": ">=2.1.0",
    "nspell": "2.1.5"
  },
  "devDependencies": {
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.8",
    "@types/node": "^22.0.0",
    "dictionary-en": "4.0.0",
    "dictionary-ru": "3.0.0",
    "solid-js": "^1.9.12",
    "typescript": "5.5.4"
  }
}
